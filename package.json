{
  "name": "featurebuilder",
  "productName": "FeatureBuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first feature specification workspace for design and verification teams",
  "license": "MIT",
  "author": "Anup Kumar Reddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anupkumarreddy/FeatureBuilder.git"
  },
  "homepage": "https://github.com/anupkumarreddy/FeatureBuilder#readme",
  "bugs": "https://github.com/anupkumarreddy/FeatureBuilder/issues",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "start": "electron ."
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.71.1",
    "vitest": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.anupkumarreddy.featurebuilder",
    "productName": "FeatureBuilder",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json", "!node_modules/**/*"],
    "asar": true,
    "npmRebuild": false,
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": "nsis" },
    "linux": { "category": "Development", "target": "AppImage" }
  }
}
